# Bearer token required for write operations (POST/PATCH/DELETE). Required at startup.
LATER_TOKEN=change-me

# Bind address; defaults to localhost only.
HOST=127.0.0.1
PORT=8787

# SQLite database file path (WAL sidecar files created next to it).
DB_PATH=./data/later.db

# Set to "true" to also require the Bearer token on read (GET) requests.
# Defaults to false (personal tool bound to localhost).
LATER_AUTH_READ=false

# ---------------------------------------------------------------------------
# Automation scripts (scripts/*.ts). These are read ONLY by the host-run
# scripts, never by the server. See README "Automation scripts". Install their
# dependencies with:  cd scripts && npm install
# ---------------------------------------------------------------------------

# Base URL the scripts use to reach this app over HTTP.
LATER_BASE_URL=http://127.0.0.1:8787
# LATER_TOKEN (above) is reused by scripts for write operations.

# --- AI summary script (scripts/summarize.ts) ---
# Page fetch backend. Optional; auto-detected from whichever base URL is set
# (crawl4ai preferred). Set explicitly to force one: crawl4ai | browserless
# SUMMARY_FETCH_BACKEND=crawl4ai
#
# Backend A: self-hosted crawl4ai REST API (returns Markdown).
# Request: POST {CRAWL4AI_BASE_URL}/crawl  {"urls":[url]}
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
# CRAWL4AI_TOKEN=            # optional bearer for crawl4ai
#
# Backend B: browserless (returns rendered HTML, converted to text locally).
# Request: POST {BROWSERLESS_API_URL}/content?token=..  {"url":url,...}
# BROWSERLESS_API_URL=https://browserless.example
# BROWSERLESS_API_TOKEN=
#
# OpenAI-compatible chat/completions endpoint for summarization.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MAX_INPUT_CHARS=12000
# Placeholder prefix written on summarize failure so the item is no longer
# selected by has_summary=false. MUST match the hardcoded SUMMARY_FAIL_PREFIX
# constant in public/index.html (export filter). If you change one, change both.
SUMMARY_FAIL_PREFIX=[auto-summary-failed]
# Directory holding the three prompt files: content.md (articles / HN story's
# linked article), discussion.md (HN story thread; supports {content} and
# {discussion} placeholders), and comment.md (single HN comment page). Any
# missing file falls back to a built-in default. In docker compose this dir is
# mounted at /app/prompts from ./scripts/prompts (edit those files to tune).
# SUMMARY_PROMPT_DIR=./prompts
# Legacy: single-file override for ONLY the content prompt (back-compat).
# SUMMARY_PROMPT_PATH=./prompt.md
# Rate limiting for external HTTP (URL-resolution probes + crawl4ai): a sliding
# window of at most SUMMARY_MAX_PER_MIN calls/minute, and at least
# SUMMARY_MIN_INTERVAL_MS between consecutive calls.
SUMMARY_MAX_PER_MIN=20
SUMMARY_MIN_INTERVAL_MS=200

# --- Hacker News script (scripts/hn.ts) ---
HN_BACKFILL_DAYS=3            # how many days the backfill cursor advances per run
HN_STORY_MIN_POINTS=100       # backfill: keep ALL stories with points >= this
HN_COMMENTS_FORWARD_MAX=30    # forward: max best-comments to import per run
HN_STATE_PATH=./data/hn-state.json

# ---------------------------------------------------------------------------
# docker compose only: the script workers run in a loop (run, sleep, repeat).
# These intervals (seconds) control how often each worker runs. State (the HN
# cursor in ./data/hn-state.json) is persisted on the ./data volume, so a plain
# `docker compose up` resumes exactly where the previous run left off.
# In compose, scripts reach the app via http://later:8787 (set automatically);
# LATER_BASE_URL above is only for host-run scripts.
# ---------------------------------------------------------------------------
RSS_INTERVAL=3600        # RSS import cadence (default 1h)
SUMMARY_INTERVAL=600     # AI summary cadence (default 10m)
SUMMARY_LIMIT=25         # items summarized per run
HN_INTERVAL=21600        # Hacker News cadence (default 6h)
