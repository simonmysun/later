{
  "name": "later",
  "version": "0.1.0",
  "description": "Personal reading-list manager: record URLs, tags, filter and sort. Node.js + node:sqlite, zero build.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
